---
import '../styles/global.css';

const title = 'Thomas Tognacci — Front-end Lead & Software Engineer';
const description =
  'Thomas Tognacci, front-end lead and software engineer based in Nice, France. React and TypeScript expertise, with back-end and DevOps experience.';
const canonicalURL = new URL('/', Astro.site!).href;

const links = [
  {
    id: 'linkedin',
    title: 'LinkedIn',
    href: 'https://www.linkedin.com/in/thomas-tognacci',
    fallback: 'in',
  },
  {
    id: 'github',
    title: 'GitHub',
    href: 'https://github.com/thomastognacci',
    fallback: '{ }',
  },
  {
    id: 'email',
    title: 'Email',
    href: 'mailto:thomas@tognacci.net',
    fallback: '✉',
  },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonicalURL}#website`,
      url: canonicalURL,
      name: 'Thomas Tognacci',
      inLanguage: 'en',
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonicalURL}#profile`,
      url: canonicalURL,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${canonicalURL}#website` },
      mainEntity: {
        '@type': 'Person',
        '@id': `${canonicalURL}#person`,
        name: 'Thomas Tognacci',
        url: canonicalURL,
        jobTitle: 'Front-end Lead & Software Engineer',
        homeLocation: { '@type': 'Place', name: 'Nice, France' },
        knowsAbout: [
          'React',
          'TypeScript',
          'Front-end development',
          'DevOps',
          'Back-end development',
        ],
        sameAs: links
          .filter((link) => link.id !== 'email')
          .map((link) => link.href),
      },
    },
  ],
};
// Deterministic positions keep the static page identical between builds.
const stars = Array.from({ length: 95 }, (_, i) => ({
  x: (i * 61.8034) % 100,
  y: (i * 37.7123) % 100,
  size: i % 9 === 0 ? 3 : i % 3 === 0 ? 2 : 1,
  opacity: 0.15 + (i % 6) * 0.1,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0c1c" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;550;600;700&family=Manrope:wght@500;800&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Thomas Tognacci" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="universe" aria-hidden="true">
      <div class="nebula"></div>
      <div class="starfield">
        {stars.map((star) => (
          <i
            style={`--x:${star.x}%;--y:${star.y}%;--size:${star.size}px;--opacity:${star.opacity}`}
          ></i>
        ))}
      </div>
    </div>
    <header class="site-header">
      <a href="#" class="wordmark" aria-label="Thomas Tognacci, home">
        <span class="monogram">
          t<span>t</span>
          <i></i>
        </span>
        <span class="wordmark-name">THOMAS TOGNACCI</span>
      </a>
      <nav aria-label="Main navigation">
        <div class="header-socials">
          {links.map((link) => (
            <a
              class="header-social-link"
              href={link.href}
              aria-label={
                link.id === 'email'
                  ? 'Email Thomas Tognacci'
                  : `${link.title} (opens in a new tab)`
              }
              title={link.title}
              target={link.id === 'email' ? undefined : '_blank'}
              rel={link.id === 'email' ? undefined : 'noopener noreferrer'}
            >
              <svg
                viewBox="0 0 24 24"
                width={link.id === 'email' ? 20 : 18}
                height={link.id === 'email' ? 20 : 18}
                fill={link.id === 'email' ? 'none' : 'currentColor'}
                stroke={link.id === 'email' ? 'currentColor' : undefined}
                stroke-width={link.id === 'email' ? '1.8' : undefined}
                stroke-linecap={link.id === 'email' ? 'round' : undefined}
                stroke-linejoin={link.id === 'email' ? 'round' : undefined}
                aria-hidden="true"
                focusable="false"
              >
                {link.id === 'linkedin' ? (
                  <path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.4-.75 1.36-1.55 2.79-1.55 2.98 0 3.58 1.96 3.58 4.5v5.3Z" />
                ) : link.id === 'github' ? (
                  <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.64 1.22 3.28.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.64 5.28-5.15 5.56.4.35.76 1.03.76 2.08v3.09c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" />
                ) : (
                  <>
                    <path d="m22 2-7 20-4-9-9-4Z" />
                    <path d="M22 2 11 13" />
                  </>
                )}
              </svg>
            </a>
          ))}
        </div>
        <a href="#about">About me</a>
      </nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="name">
        <div class="intro">
          <p class="eyebrow">SOFTWARE ENGINEER · FRONT-END LOVER</p>
          <h1 id="name">
            Thomas <span>Tognacci</span>
          </h1>
          <p class="intro-copy">
            Front-end is my home base.
            <br />I build across the stack.
          </p>
        </div>
        <div class="orbit-stage" aria-label="Find me online">
          <span class="spark spark-one" aria-hidden="true">
            ✦
          </span>
          <span class="spark spark-two" aria-hidden="true">
            ✧
          </span>
          <div id="scene" aria-hidden="true"></div>
          <div class="social-links">
            {links.map((link) => (
              <div class={`social-slot ${link.id}`}>
                <a
                  class={`social-link ${link.id}`}
                  data-object={link.id}
                  href={link.href}
                  aria-label={
                    link.id === 'email'
                      ? 'Email Thomas Tognacci'
                      : `${link.title} (opens in a new tab)`
                  }
                  target={link.id === 'email' ? undefined : '_blank'}
                  rel={link.id === 'email' ? undefined : 'noopener noreferrer'}
                >
                  <span class="object-space" aria-hidden="true">
                    <picture class="mobile-static-object">
                      <img
                        src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
                        data-src={`/icons/${link.id}.png`}
                        alt=""
                        width="76"
                        height="76"
                        decoding="async"
                      />
                    </picture>
                    <span class="fallback-object">{link.fallback}</span>
                  </span>
                </a>
              </div>
            ))}
          </div>
        </div>
        <div class="hero-bottom">
          <button
            id="reset-positions"
            class="motion-control"
            type="button"
            hidden
          >
            Reset positions
          </button>
          <button
            class="motion-control"
            id="motion-toggle"
            type="button"
            aria-pressed="false"
            hidden
          >
            <span class="motion-icon" aria-hidden="true">
              Ⅱ
            </span>
            <span class="motion-label">Pause motion</span>
          </button>
        </div>
      </section>
      <section id="about" class="about" aria-labelledby="about-title">
        <div class="about-content">
          <h2 id="about-title">
            Front-end roots.
            <br />
            <span>A wider perspective.</span>
          </h2>
          <div class="about-copy">
            <p>
              I’m Thomas, a software engineer from Nice and currently a
              front-end lead. My core expertise is React and TypeScript, backed
              by solid DevOps and back-end experience.
            </p>
            <p>
              I enjoy working across those boundaries, connecting the interface
              to the systems behind it.
            </p>
            <p>
              AI has become a natural part of how I build, experiment, and
              learn.
            </p>
            <p class="language-note">
              French & English <span> / </span> Based in Nice, France
            </p>
            <a class="text-link" href="mailto:thomas@tognacci.net">
              thomas@tognacci.net <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
