---
import '../styles/global.css';

const links = [
  {
    id: 'linkedin',
    title: 'LinkedIn',
    href: 'https://www.linkedin.com/in/thomas-tognacci',
    fallback: 'in',
  },
  {
    id: 'github',
    title: 'GitHub',
    href: 'https://github.com/thomastognacci',
    fallback: '{ }',
  },
  {
    id: 'email',
    title: 'Email',
    href: 'mailto:thomas@tognacci.net',
    fallback: '✉',
  },
];
// Deterministic positions keep the static page identical between builds.
const stars = Array.from({ length: 95 }, (_, i) => ({
  x: (i * 61.8034) % 100,
  y: (i * 37.7123) % 100,
  size: i % 9 === 0 ? 3 : i % 3 === 0 ? 2 : 1,
  opacity: 0.15 + (i % 6) * 0.1,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0c1c" />
    <title>Thomas Tognacci — Software Engineer · Front-end Lover</title>
    <meta
      name="description"
      content="Software Engineer and Front-end Lead. Front-end expertise, full-stack curiosity. Get to know Thomas Tognacci and explore his work on GitHub."
    />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Thomas Tognacci — Software Engineer · Front-end Lead"
    />
    <meta
      property="og:description"
      content="Front-end is my home base. I build across the stack."
    />
    <meta property="og:url" content={Astro.site} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="universe" aria-hidden="true">
      <div class="nebula"></div>
      <div class="starfield">
        {stars.map((star) => (
          <i
            style={`--x:${star.x}%;--y:${star.y}%;--size:${star.size}px;--opacity:${star.opacity}`}
          ></i>
        ))}
      </div>
    </div>
    <header class="site-header">
      <a href="#" class="wordmark" aria-label="Thomas Tognacci, home">
        <span class="monogram">
          t<span>t</span>
          <i></i>
        </span>
        <span class="wordmark-name">THOMAS TOGNACCI</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#about">About me</a>
        <a class="hello-link" href="mailto:thomas@tognacci.net">
          Say hello <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="name">
        <div class="intro">
          <p class="eyebrow">
            SOFTWARE ENGINEER · FRONT-END LOVER
          </p>
          <h1 id="name">
            Thomas{' '}
            <span>
              Tognacci
            </span>
          </h1>
          <p class="intro-copy">
            Front-end is my home base.
            <br />I build across the stack.
          </p>
        </div>
        <div class="orbit-stage" aria-label="Find me online">
          <div class="orbit-ring" aria-hidden="true"></div>
          <span class="spark spark-one" aria-hidden="true">
            ✦
          </span>
          <span class="spark spark-two" aria-hidden="true">
            ✧
          </span>
          <div id="scene" aria-hidden="true"></div>
          <div class="social-links">
            {links.map((link) => (
              <div class={`social-slot ${link.id}`}>
                <a
                  class={`social-link ${link.id}`}
                  data-object={link.id}
                  href={link.href}
                  aria-label={
                    link.id === 'email'
                      ? 'Email Thomas Tognacci'
                      : `${link.title} (opens in a new tab)`
                  }
                  target={link.id === 'email' ? undefined : '_blank'}
                  rel={link.id === 'email' ? undefined : 'noopener noreferrer'}
                >
                  <span class="object-space" aria-hidden="true">
                    <span class="fallback-object">{link.fallback}</span>
                  </span>
                </a>
              </div>
            ))}
          </div>
        </div>
        <div class="hero-bottom">
          <button
            id="reset-positions"
            class="motion-control"
            type="button"
            hidden
          >
            Reset positions
          </button>
          <button
            class="motion-control"
            id="motion-toggle"
            type="button"
            aria-pressed="false"
            hidden
          >
            <span class="motion-icon" aria-hidden="true">
              Ⅱ
            </span>
            <span class="motion-label">Pause motion</span>
          </button>
        </div>
      </section>
      <section id="about" class="about" aria-labelledby="about-title">
        <div class="about-content">
          <h2 id="about-title">
            Front-end roots.
            <br />
            <span>A wider perspective.</span>
          </h2>
          <div class="about-copy">
            <p>
              I’m Thomas, a software engineer from Nice and currently a front-end lead.
My core expertise is React and TypeScript, backed by solid DevOps and back-end experience.
            </p>
            <p>I enjoy working across those boundaries, connecting the interface to the systems behind it. 
            </p>
            <p>
            AI has become a natural part of how I build, experiment, and learn.
            </p>
            <p class="language-note">
              French & English <span> / </span> Based in Nice, France
            </p>
            <a class="text-link" href="mailto:thomas@tognacci.net">
              thomas@tognacci.net <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
